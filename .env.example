# No paid service is required. First use downloads a speech model.
ASR_MODEL=base
ASR_THREADS=4
# Optional: use groq instead of local speech recognition.
ASR_PROVIDER=local
GROQ_API_KEY=
# Optional demo speech generation uses the online Edge TTS service.
TTS_PROVIDER=edge
# Keep local unless you add authentication and HTTPS.
HOST=127.0.0.1
PORT=8765
